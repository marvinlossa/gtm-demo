# Browser-facing URL (portfolio subdomain)
NEXT_PUBLIC_APP_URL=https://gtm-demo.marvinlossa.com

# Callback base for n8n → app (Docker-reachable). Falls back to NEXT_PUBLIC_APP_URL.
# Local + docker compose n8n:
# APP_PUBLIC_URL=http://host.docker.internal:3000
# APP_CALLBACK_URL=http://host.docker.internal:3000
APP_PUBLIC_URL=
APP_CALLBACK_URL=

# Cloudflare Turnstile (demo protection — same pattern as Content Brief Creator)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ADMIN_IP_ALLOWLIST=
INTAKE_DAILY_LIMIT=2
# Total analyses per IP for the life of the demo (default 4)
INTAKE_LIFETIME_LIMIT=4

# Job / orchestration
JOB_TIMEOUT_MS=240000
JOB_RETENTION_MS=172800000
MAX_INFLIGHT_JOBS=3
N8N_TRIGGER_TIMEOUT_MS=10000
# Live n8n (when MOCK_N8N=0): production webhook URL from activated workflow
N8N_WEBHOOK_URL=
# Must match n8n env (docker-compose defaults: dev-webhook-secret / dev-callback-secret)
GTM_WEBHOOK_SECRET=dev-webhook-secret
GTM_CALLBACK_SECRET=dev-callback-secret
# Local default: mock n8n completes jobs without a live workflow
MOCK_N8N=1
MOCK_N8N_DELAY_MS=1500

# SQLite (PR 1.5+) — local default is .data/gtm-demo.sqlite
SQLITE_PATH=
# Railway volume:
# SQLITE_PATH=/data/gtm-demo.sqlite

# Poll GET rate limit (jobs API)
GET_POLL_LIMIT_PER_MIN=60

# --- n8n service only (docker compose / Railway n8n). Do NOT put on app in production. ---
# PERPLEXITY_API_KEY=
# PERPLEXITY_RESEARCH_MODEL=perplexity/sonar
# OPENROUTER_API_KEY=
# OPENROUTER_STRATEGY_MODEL=x-ai/grok-4.3
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=admin

